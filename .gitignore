# Build output
target

# Local data, datasets and stores (never committed — see README "Configuration")
database/data
database/datasets
*.db
*.db-wal
*.db-log
*.weftseg
*.weftpart
# ...except the checked-in compatibility fixtures, which are stores on purpose: a
# v0.1.0 Turso metadata.db cannot be regenerated in CI, so its databases and frames
# are committed byte-for-byte (see compat/releases.toml and compat/fixtures/).
!weftdb/tests/fixtures/**
!compat/fixtures/**

# Agent/routine scratch output (transient run logs, bench output, server logs)
scratch

# OS and editor cruft
.DS_Store
Thumbs.db
*-cwd
*.claude
nul

# Crash dumps and stray debug captures
rustc-ice-*.txt
*_debug.txt
DETAILED_CHANGES.txt

# Editor workspace settings
.vscode
.zed

# Python bytecode (scripts/contrib)
__pycache__
