# /etc/weftdb/weft-server.env — the WeftDB server's environment file (1.0 plan PAC-11).
#
# Loaded by packaging/systemd/weft-server.service through
# `EnvironmentFile=-/etc/weftdb/weft-server.env`, and by the container through
# `--env-file` or `WEFT_*` `-e` flags (packaging/docker/Dockerfile). One file, one set of
# names, both deployment styles: that is deliberate, and it is why a host node and a container
# node of the same version cannot drift into behaving differently from each other.
#
# Format: `NAME=value`, one per line. systemd reads this file literally — no `export`, no
# shell expansion, no command substitution, no quoting rules beyond a plain `=`. A `#` line is
# a comment. Values are not shell-evaluated, so `WEFT_DATA_DIR=$(pwd)` is a literal string,
# and the server will tell you so rather than run with it.
#
# **The server validates this file before it opens anything, and refuses to start on a name it
# does not know** (PAC-5b). That is not a warning: an unrecognised variable — a typo, a renamed
# option, a leftover from an older version — is exit 78 with the offending name in the message,
# and the journal reads `status=78/CONFIG`. Test-harness variables are refused here too, so a
# testing knob cannot reach a production node by accident. The list below is the registry in
# `weft-server/src/settings.rs`, generated from it, so every name here is one the server accepts;
# the tier is the registry's own, and it is a promise about how long the name will live:
#
#     Stable        supported across minor releases; a deployment may depend on it
#     Tuning        same name and meaning, but the value's shape may gain bounds
#     Experimental  may change or disappear in any release; do not build on it
#
# Editing: copy this file to /etc/weftdb/weft-server.env, uncomment what you need, then
# `systemctl restart weft-server`. scripts/packaging/install-host.sh will not overwrite an
# /etc/weftdb/weft-server.env it did not write, so an upgrade keeps your edits; the template is
# re-installed to /usr/share/doc/weftdb/weft-server.env.example for comparison.
#
# The two lines most deployments end up setting are a keys file and a bind address:
#
#     WEFT_KEYS_FILE=/etc/weftdb/api.keys      # auth is on iff a keys file is mounted
#     WEFT_SERVER_ADDR=0.0.0.0:8080            # non-loopback plaintext needs WEFT_ALLOW_PLAINTEXT=1,
#                                              # or a TLS certificate pair, or WEFT_AUTH=disabled
#
# A note on paths: the service runs with `ProtectSystem=strict` and `ProtectHome=yes`, so a
# value here that points under /home will not resolve, and one that points outside
# /var/lib/weftdb must be added to the unit's `ReadWritePaths=` in a drop-in. Put the store and
# the backups inside the state directory and neither question arises.

# ── Stable: supported across minor releases ────────────────────────────────────────────

# OTEL_EXPORTER_OTLP_ENDPOINT
#   accepts: a collector endpoint, e.g. `http://localhost:4317`; userinfo is allowed (collector
#   basic auth) and is redacted from everything the server prints (SEC-10)
#   default:  unset: no exporter and no network dependency; `fmt` logging only
#OTEL_EXPORTER_OTLP_ENDPOINT=

# WEFT_ALLOW_ANY_HOST
#   accepts: unset or `0` keeps the guard on; any other value turns it off
#   default:  unset: loopback-only guard (a non-loopback bind is unguarded, which is why it must
#   stay off untrusted networks)
#WEFT_ALLOW_ANY_HOST=

# WEFT_ALLOW_PLAINTEXT
#   accepts: `1`/`true`/`yes`/`on` (any case) opts in; unset, `0` or anything else does not
#   default:  unset: a non-loopback plaintext bind without TLS or `WEFT_AUTH=disabled` is refused at
#   startup
#WEFT_ALLOW_PLAINTEXT=

# WEFT_AUTH
#   accepts: `keys` or `disabled` (any case); any other value stops the server from starting
#   default:  unset: authentication is on when `WEFT_KEYS_FILE` names a mounted keys file, and off
#   when none is mounted
#WEFT_AUTH=keys

# WEFT_BACKUP_DIR
#   accepts: a directory path (absolute, or relative to the process's working directory)
#   default:  `<store root>/backups`
#WEFT_BACKUP_DIR=/var/lib/weftdb/store/backups

# WEFT_DATA_DIR
#   accepts: a directory path
#   default:  `~/.weftdb/data`
#WEFT_DATA_DIR=/var/lib/weftdb

# WEFT_KEYS_FILE
#   accepts: a path to a keys file in the SEC-6 format (see weft-server/auth.rs); a file that cannot
#   be parsed stops the server from starting
#   default:  unset: no keys file — authentication is off (and `WEFT_AUTH=keys` then refuses to
#   start), proxied requests are refused while it is off, and a non-loopback bind refuses to start
#   without keys or `WEFT_AUTH=disabled`, TLS included (SEC-8's exposure matrix)
#WEFT_KEYS_FILE=/etc/weftdb/api.keys

# WEFT_ON_AMBIGUOUS_COMMIT
#   accepts: `poison` (or unset) keeps serving; `exit` exits with status 70
#   default:  serve; an unknown value stops the server from starting (PAC-5b strict configuration)
#WEFT_ON_AMBIGUOUS_COMMIT=

# WEFT_SEGMENT_STORE_ROOT
#   accepts: a directory path; the Storage v2 layout is created there if absent
#   default:  unset: no store — the stateless interpolate/downsample API only, and `503` on storage
#   reads
#WEFT_SEGMENT_STORE_ROOT=/var/lib/weftdb/store

# WEFT_SERVER_ADDR
#   accepts: a `host:port` socket address, e.g. `0.0.0.0:9000`
#   default:  `127.0.0.1:8080`; an unparseable value stops the server from starting
#WEFT_SERVER_ADDR=127.0.0.1:8080

# WEFT_TLS_CERT_FILE
#   accepts: a path to a PEM file holding the certificate chain
#   default:  unset: no TLS — the listener is plaintext and the C8 gate applies
#WEFT_TLS_CERT_FILE=

# WEFT_TLS_KEY_FILE
#   accepts: a path to a PEM file holding the private key
#   default:  unset: no TLS — the listener is plaintext and the C8 gate applies
#WEFT_TLS_KEY_FILE=


# ── Tuning: same names and meanings, values may gain bounds ─────────────────────────
# Everything a node operator reaches for on a busy machine. Left at its default until the
# numbers say otherwise; the default column is the behaviour of a node that sets nothing.

# WEFT_BACKUP_INTERVAL_SECS
#   accepts: a whole number of seconds; `0` disables the daemon
#   default:  unset or `0`: no scheduled backups
#WEFT_BACKUP_INTERVAL_SECS=86400

# WEFT_BACKUP_KEEP
#   accepts: a whole number of snapshots
#   default:  unset: retain every generated snapshot (packaged deployments set 3)
#WEFT_BACKUP_KEEP=3

# WEFT_COMPACT_TARGET_ROWS
#   accepts: a positive whole number of rows
#   default:  unset: no compaction pass
#WEFT_COMPACT_TARGET_ROWS=

# WEFT_EXTRACTED_BATCH_RETENTION_SECS
#   accepts: a positive whole number of seconds
#   default:  48 h (172800 s); anything else warns and keeps the default
#WEFT_EXTRACTED_BATCH_RETENTION_SECS=

# WEFT_HEADER_READ_TIMEOUT_SECS
#   accepts: a positive whole number of seconds
#   default:  30 s (`DEFAULT_HEADER_READ_TIMEOUT` in serve.rs)
#WEFT_HEADER_READ_TIMEOUT_SECS=

# WEFT_INGEST_MAX_INFLIGHT_BYTES
#   accepts: a positive whole number of bytes
#   default:  256 MiB — one maximum-size body in flight
#WEFT_INGEST_MAX_INFLIGHT_BYTES=

# WEFT_KEEP_ALIVE_TIMEOUT_SECS
#   accepts: a positive whole number of seconds
#   default:  30 s (`DEFAULT_KEEP_ALIVE_TIMEOUT` in serve.rs)
#WEFT_KEEP_ALIVE_TIMEOUT_SECS=

# WEFT_LEGACY_DEFAULT_STORAGE
#   accepts: exactly `segments` for seal-backed; anything else is rows mode
#   default:  unset: rows mode — measurements live in the per-aspect `measurements.db`, as before
#   D-S19
#WEFT_LEGACY_DEFAULT_STORAGE=

# WEFT_MAX_CONNECTIONS
#   accepts: a positive whole number of connections
#   default:  half the process's `RLIMIT_NOFILE` soft limit, clamped to 16..=65,536 (1,024 when the
#   limit cannot be read)
#WEFT_MAX_CONNECTIONS=

# WEFT_MAX_INGEST_BYTES
#   accepts: a positive whole number of bytes
#   default:  256 MiB (`DEFAULT_MAX_INGEST_BYTES` in ingest.rs)
#WEFT_MAX_INGEST_BYTES=

# WEFT_MAX_INTERPOLATE_POINTS
#   accepts: a positive whole number of points
#   default:  10,000,000 (`MAX_INTERPOLATE_OUTPUT_POINTS`); anything else stops the server from
#   starting
#WEFT_MAX_INTERPOLATE_POINTS=

# WEFT_QUERY_MAX_INFLIGHT
#   accepts: a positive whole number of requests
#   default:  128 (`DEFAULT_QUERY_MAX_INFLIGHT` in admission.rs); anything else stops the server
#   from starting
#WEFT_QUERY_MAX_INFLIGHT=

# WEFT_RECONCILE_HOT_COLD
#   accepts: `1`/`true`/`yes`/`on` (case-insensitive)
#   default:  unset or falsey: threshold sweep
#WEFT_RECONCILE_HOT_COLD=

# WEFT_RECONCILE_INTERVAL_SECS
#   accepts: a whole number of seconds; `0` disables the daemon
#   default:  unset or `0`: no reconcile daemon; a non-numeric value stops the server from starting
#WEFT_RECONCILE_INTERVAL_SECS=

# WEFT_RECONCILE_MAX_SPLITS
#   accepts: a positive whole number of segments
#   default:  unset: no squash pass
#WEFT_RECONCILE_MAX_SPLITS=

# WEFT_RECONCILE_OVERLAPS
#   accepts: `1`/`true`/`yes`/`on` (case-insensitive)
#   default:  unset or falsey: no overlap merge
#WEFT_RECONCILE_OVERLAPS=

# WEFT_RECONCILE_SPLIT_MIN_BYTES
#   accepts: a whole number of bytes
#   default:  50 MiB
#WEFT_RECONCILE_SPLIT_MIN_BYTES=

# WEFT_RECONCILE_THRESHOLD
#   accepts: a non-negative whole number of segments
#   default:  1 — any aspect with at least one out-of-order segment; a non-numeric value stops the
#   server from starting
#WEFT_RECONCILE_THRESHOLD=

# WEFT_SEGMENT_CHECKPOINT_MAX_CODEC_OVERHEAD
#   accepts: a finite number at or above 1.0 (`1.0` = only when free)
#   default:  1.25 (`DEFAULT_CHECKPOINT_MAX_CODEC_OVERHEAD`)
#WEFT_SEGMENT_CHECKPOINT_MAX_CODEC_OVERHEAD=

# WEFT_SEGMENT_CHECKPOINT_MIN_ROWS
#   accepts: a positive whole number of rows
#   default:  8,192 (`DEFAULT_CHECKPOINT_MIN_ROWS`)
#WEFT_SEGMENT_CHECKPOINT_MIN_ROWS=

# WEFT_SEGMENT_CHECKPOINT_STRIDE
#   accepts: a positive whole number of rows (~1024 measured the sweet spot)
#   default:  unset or `0`: no checkpoint index; the frames WeftDB has always written
#WEFT_SEGMENT_CHECKPOINT_STRIDE=

# WEFT_SEGMENT_PARTIAL_BASE
#   accepts: one resolution token — `seconds`, `minutes`, `hours`, …
#   default:  unset or unparseable: no sidecar
#WEFT_SEGMENT_PARTIAL_BASE=

# WEFT_SEGMENT_PARTIAL_MIN_ROWS
#   accepts: a positive whole number of rows
#   default:  4,096 (`DEFAULT_PARTIAL_SIDECAR_MIN_ROWS`)
#WEFT_SEGMENT_PARTIAL_MIN_ROWS=

# WEFT_SEGMENT_PARTIAL_TIERS
#   accepts: a comma-separated list of resolution tokens, e.g. `hours,days`; unparseable entries are
#   dropped
#   default:  unset: base only
#WEFT_SEGMENT_PARTIAL_TIERS=

# WEFT_SHUTDOWN_GRACE_SECS
#   accepts: a positive whole number of seconds
#   default:  5 s (`SHUTDOWN_DRAIN` in serve.rs)
#WEFT_SHUTDOWN_GRACE_SECS=10

# WEFT_STORE_DATABASE
#   accepts: a database name, e.g. `default` or `v010_legacy`
#   default:  `default`, the database `weftdb::SegmentStore::open` uses, so a store written before
#   this variable existed keeps opening the same way
#WEFT_STORE_DATABASE=

# WEFT_STORE_SUBJECT
#   accepts: a subject name
#   default:  `default`, the subject `weftdb::SegmentStore::open` uses
#WEFT_STORE_SUBJECT=

# WEFT_WRITE_STALL_TIMEOUT_SECS
#   accepts: a positive whole number of seconds
#   default:  10 s (`DEFAULT_WRITE_STALL_TIMEOUT` in serve.rs)
#WEFT_WRITE_STALL_TIMEOUT_SECS=


# ── Experimental: may change or disappear in any release ─────────────────────────────

# WEFT_GPU_CALIBRATE
#   accepts: `0`/`false`/`no`/`off` skips; `force` also calibrates a software adapter (llvmpipe,
#   lavapipe, WARP); anything else calibrates a real GPU
#   default:  auto: calibrate when a real GPU is present
#WEFT_GPU_CALIBRATE=

# WEFT_SEGMENT_TRANSPOSED_MAX_OVERHEAD
#   accepts: a finite number above 0 (`1.0` = only when free)
#   default:  unset: the ordinary size-selected codec; a build without the feature warns once and
#   ignores it
#WEFT_SEGMENT_TRANSPOSED_MAX_OVERHEAD=

# ── Not listed on purpose ──────────────────────────────────────────────────────────────
#
# 31 further names in the registry are tiered `Test` — fault injectors, benchmark corpora,
# crash-child markers. They are registered precisely so that this file *cannot* carry one: a
# testing knob on a real node is a wrong answer waiting for a traffic pattern. Setting any of
# them here is an exit-78 refusal naming the variable, not a silent no-op.
#
# The full registry, tiers and all, is one file:
#     grep -n 'tier: Tier::' weft-server/src/settings.rs
